{
  "manifest_version": 3,
  "name": "Pokevin",
  "key": "",
  "version": "0.4.6",
  "description": "Estime les chances de victoire des champions et rencontres spéciales, et propose une équipe avec le moteur du jeu isolé de ta partie.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "arena-coach@pokecatch.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["engine/core.js", "simulator.js", "encounter-simulator.js", "optimizer.js", "chapter-xp.js", "background.js"]
  },
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://pokecatch-online.netlify.app/*"],
    "js": ["ui/chapter-data.js", "ui/react-ui.js", "apply-team.js", "content.js", "encounter-content.js"],
    "css": ["ui/badge.css", "ui/tooltip.css", "ui/advisor.css", "ui/chapter-preview.css", "ui/friend-dex.css", "ui/pension.css"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
