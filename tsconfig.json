{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "chrome",
      "react",
      "react-dom"
    ],
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "plugin/content.js",
    "plugin/save-reader.js",
    "plugin/background.js",
    "plugin/simulator.js",
    "plugin/chapter-xp.js",
    "plugin/optimizer.js",
    "plugin/apply-team.js",
    "plugin/pc-multiselect.js",
    "plugin/ui/**/*.jsx",
    "plugin/ui/version-warning.js",
    "plugin/ui/pension.js",
    "plugin/types/**/*.d.ts",
    "tests/typecheck-contracts.js",
    "plugin/encounter-simulator.js",
    "plugin/encounter-content.js",
    "plugin/automation.js",
    "plugin/sdk/**/*.js",
    "plugin/scripts/**/*.js",
    "plugin/editor-loader.js",
    "plugin/ui/script-editor.js"
  ]
}
