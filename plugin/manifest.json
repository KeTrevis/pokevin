{
  "manifest_version": 3,
  "name": "Pokevin",
  "key": "",
  "version": "0.4.6",
  "description": "Estime les chances de victoire des champions et rencontres sp\u00e9ciales, et propose une \u00e9quipe avec le moteur du jeu isol\u00e9 de ta partie.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "arena-coach@pokecatch.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "script-editor.html",
        "assets/*",
        "chunks/*"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://pokecatch-online.netlify.app/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
